{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node node_modules/vitest/vitest.mjs run --config vitest.stryker.config.mjs --coverage.enabled=false"
  },
  "testRunner_comment": "Same Phase 02 switch as packages/db and packages/api: the vitest plugin's per-mutant runs complete zero tests under vitest 5.0.1; the command runner relies on the vitest exit code instead.",
  "reporters": ["clear-text", "progress", "html", "json"],
  "coverageAnalysis": "off",
  "mutate": ["src/**/*.ts"],
  "ignorePatterns": ["../../legacy/**", "coverage/**"],
  "thresholds": { "high": 90, "low": 80, "break": 80 },
  "htmlReporter": { "fileName": "../../reports/proof/mutation/schemas/mutation.html" },
  "jsonReporter": { "fileName": "../../reports/proof/mutation/schemas/mutation.json" }
}
